Screen {
    layout: vertical;
    background: #0d1117;
}

#main-container {
    height: 1fr;
}

#top-panels {
    height: 2fr;
}

#left-sidebar {
    width: 30%;
}

#center-panel {
    width: 70%;
}

#bottom-panels {
    height: 1fr;
}

TelemetryPanel {
    height: 100%;
    background: #161b22;
    border: round #58a6ff;
    padding: 1;
    margin: 1;
}

SwarmDebatePanel {
    width: 50%;
    height: 100%;
    background: #161b22;
    border: round #3fb950;
    padding: 1;
    margin: 1 0 1 1;
}

RoutinesPanel {
    width: 50%;
    height: 100%;
    background: #161b22;
    border: round #d2a8ff;
    padding: 1;
    margin: 1;
}

FlightRecorderLog {
    height: 100%;
    background: #161b22;
    border: round #58a6ff;
    padding: 1;
    margin: 1 1 1 0;
}

.panel-title {
    text-align: center;
    text-style: bold;
    color: #e6edf3;
    margin-bottom: 1;
}

.tier-badge, .intent-badge {
    color: #0d1117;
    background: #58a6ff;
    text-style: bold;
    padding: 0 1;
}

.debate-proposed {
    color: #d2a8ff;
}

.debate-approved {
    color: #3fb950;
}

.debate-rejected {
    color: #f85149;
}

#offline-overlay {
    dock: top;
    height: 100%;
    width: 100%;
    background: rgba(13, 17, 23, 0.85);
    align: center middle;
    display: none;
}

.offline-pulse {
    color: #f85149;
    text-style: bold;
    content-align: center middle;
    width: auto;
    height: auto;
}
