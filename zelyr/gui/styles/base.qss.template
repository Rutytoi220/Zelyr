/* Zelyr Global Theme Template */

/* =========================================================================
   KDE / Wayland Focus Ring Nuclear Override
   Must be FIRST so nothing can override it back.
   ========================================================================= */
* { outline: none; }
QTreeWidget { outline: 0; show-decoration-selected: 0; }



QWidget {
    background-color: @bg_base@;
    color: @text_main@;
    font-family: @font_main@;
}

QMainWindow, QDialog {
    background-color: @bg_base@;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: @bg_surface@;
    color: @text_main@;
    border: 1px solid @borders@;
    border-radius: @radius_pill@;
    padding: 8px 12px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid @text_muted@;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: @bg_surface@;
    color: @text_main@;
    border: 1px solid @borders@;
    border-radius: @radius_sm@;
    selection-background-color: @accent@;
}

QPushButton, QToolButton {
    background-color: @bg_surface@;
    color: @text_main@;
    border: 1px solid @borders@;
    border-radius: @radius_pill@;
    padding: @spacing_sm@ @spacing_md@;
}

QScrollBar:vertical { border: none; background: transparent; width: 6px; margin: 0px; }
QScrollBar::handle:vertical { background: rgba(255, 255, 255, 0.15); min-height: 20px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.3); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { border: none; background: none; height: 0px; }

QPushButton:hover, QToolButton:hover {
    border: 1px solid @primary@;
    color: @accent@;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: @primary@;
    color: @bg_base@;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: transparent;
    color: @text_muted@;
    border: 1px solid @borders@;
}

QFrame#surface, QFrame#border {
    background-color: @bg_surface@;
    border: 1px solid @borders@;
    border-radius: @radius_pill@;
    padding: @spacing_md@;
}

QLabel {
    color: @text_main@;
}

/* =========================================================================
   Semantic Status Property Selectors
   ========================================================================= */
QLabel[status="danger"] {
    color: @danger@;
    font-weight: bold;
}

QLabel[status="warning"] {
    color: @accent@;
}

QLabel[status="success"] {
    color: @success@;
}

QLabel[status="muted"] {
    color: @text_muted@;
}

QLabel[status="info"] {
    color: @primary@;
}

QPushButton[status="danger"] {
    background-color: @danger@;
    color: @bg_base@;
    font-weight: bold;
}

QPushButton[status="success"] {
    background-color: @success@;
    color: @bg_base@;
    font-weight: bold;
}

QPushButton[status="warning"] {
    background-color: @accent@;
    color: @bg_base@;
    font-weight: bold;
}

/* =========================================================================
   Hub / Network Dialog Cards
   ========================================================================= */
QFrame#hub_card {
    background-color: @bg_surface@;
    border-radius: @radius_pill@;
    padding: @spacing_md@;
}

QLabel#hub_name {
    font-weight: bold;
    font-size: 16px;
    color: @text_main@;
}

QLabel#hub_author {
    color: @primary@;
    font-size: 13px;
    font-weight: 500;
}

QLabel#hub_desc {
    color: @text_muted@;
    font-size: 14px;
}

QLabel#hub_tags {
    color: @accent@;
    font-size: 12px;
}

QFrame#hub_version {
    background-color: @bg_base@;
    color: @success@;
    padding: 2px 6px;
    border-radius: @radius_sm@;
    font-size: 12px;
    font-weight: bold;
}

/* Status Pill */
QLabel#chat_status_pill, StatusPill {
    border-radius: @radius_sm@;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}
StatusPill[status="online"] {
    background-color: @success@;
    color: @bg_base@;
}
StatusPill[status="warning"] {
    background-color: #ffcc00;
    color: @bg_base@;
}
StatusPill[status="offline"] {
    background-color: transparent;
    color: @text_muted@;
    border: 1px solid @borders@;
}

/* Telemetry Bar */
QProgressBar#telemetry_bar {
    background-color: @bg_deep@;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}
QProgressBar#telemetry_bar::chunk {
    border-radius: 3px;
}
QProgressBar#telemetry_bar[status="normal"]::chunk {
    background-color: @accent@;
}
QProgressBar#telemetry_bar[status="warning"]::chunk {
    background-color: #ffcc00;
}
QProgressBar#telemetry_bar[status="danger"]::chunk {
    background-color: @danger@;
}

QLabel#telemetry_title {
    font-size: 11px;
    font-weight: bold;
}
QLabel#telemetry_val {
    font-size: 11px;
    color: @accent@;
}

/* =========================================================================
   Sync Dialog
   ========================================================================= */
QLabel#sync_pin {
    font-size: 32px;
    letter-spacing: 4px;
    font-weight: bold;
    color: @success@;
}

QLabel#sync_status {
    color: @accent@;
    font-style: italic;
}

QLineEdit#sync_input {
    padding: 8px;
    border-radius: @radius_sm@;
    background-color: @bg_surface@;
    color: @text_main@;
    font-size: 14px;
}

QPushButton#sync_host {
    background-color: @primary@;
    color: @bg_base@;
    font-weight: bold;
    padding: 12px;
    border-radius: @radius_pill@;
    font-size: 16px;
}

QPushButton#sync_connect {
    background-color: @success@;
    color: @bg_base@;
    font-weight: bold;
    padding: 12px;
    border-radius: @radius_pill@;
    font-size: 16px;
}

QPushButton#sync_action {
    background-color: @accent@;
    color: @bg_base@;
    font-weight: bold;
    padding: 10px;
    border-radius: @radius_pill@;
    font-size: 14px;
}

/* =========================================================================
   Plugin Manager
   ========================================================================= */
QFrame#plugin_card {
    background-color: transparent;
    border: none;
}

QLabel#plugin_name {
    font-weight: bold;
    color: @text_main@;
    font-size: 14px;
}

QLabel#plugin_desc {
    color: @text_muted@;
    font-size: 12px;
}

QLabel#plugin_loading {
    color: @text_muted@;
    font-style: italic;
}

QCheckBox#plugin_toggle {
    color: @text_muted@;
    font-weight: bold;
    background: transparent;
}

QCheckBox#plugin_toggle::indicator {
    width: 36px;
    height: 18px;
    border-radius: 9px;
}

QCheckBox#plugin_toggle::indicator:checked {
    background-color: @success@;
    border: 2px solid @success@;
}

QCheckBox#plugin_toggle::indicator:unchecked {
    background-color: @bg_surface@;
    border: 2px solid @borders@;
}

QPushButton#plugin_close {
    background-color: @bg_surface@;
    color: @text_main@;
    padding: 6px;
    border-radius: @radius_sm@;
    font-weight: bold;
}

/* =========================================================================
   Update Dialog
   ========================================================================= */
QLabel#update_header {
    color: @success@;
}

QTextEdit#update_changelog {
    background-color: @bg_base@;
    color: @text_main@;
    border-radius: @radius_pill@;
    padding: @spacing_md@;
}

QPushButton#update_install {
    background-color: @success@;
    color: @bg_base@;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: @radius_pill@;
}

QPushButton#update_later {
    background-color: @bg_surface@;
    color: @text_main@;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: @radius_pill@;
}

/* =========================================================================
   Chat Status Pill
   ========================================================================= */
QLabel#chat_status_pill {
    color: @text_muted@;
    font-style: italic;
    margin-left: 12px;
    margin-bottom: 8px;
}

QTextEdit.code, QPlainTextEdit.code {
    font-family: @font_mono@;
}

/* =========================================================================
   Sidebar Segmented Control — Apple-style iOS picker pill
   ========================================================================= */
QFrame#segmented_control {
    background-color: transparent;
    border: none;
    padding: 3px;
}
QPushButton#segmented_btn {
    background-color: transparent;
    color: @text_muted@;
    border: none;
    border-radius: 12px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#segmented_btn:hover {
    color: @text_main@;
    background-color: transparent;
}
QPushButton#segmented_btn[status="active"] {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: bold;
}
/* Native :checked state — works without unpolish/polish */
QPushButton#segmented_btn:checked {
    background-color: @primary@;
    border-radius: 10px;
    color: @bg_base@;
    font-weight: bold;
}
QPushButton#segmented_btn[position="first"] {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}
QPushButton#segmented_btn[position="last"] {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* =========================================================================
   Sidebar Action Buttons — Squircle (+ New Chat, + Project, Zelyr Hub)
   ========================================================================= */
QPushButton#sidebar_action_btn {
    background-color: transparent;
    color: @text_main@;
    border: none;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}
QPushButton#sidebar_action_btn:hover {
    background-color: @bg_surface@;
    color: #FFFFFF;
    border: none;
}
QPushButton#sidebar_action_btn:pressed {
    background-color: @bg_surface@;
    color: #FFFFFF;
    border: none;
}

/* =========================================================================
   Conversation List — override default Qt blue selection highlight
   ========================================================================= */
QTreeWidget {
    background-color: transparent;
    border: none;
    outline: none;
}
QTreeWidget:focus {
    outline: none;
}
QTreeWidget::item {
    border-radius: 8px;
    padding: 2px 4px;
    margin: 2px 8px;
    color: @text_main@;
    outline: none;
}
QTreeWidget::item:focus {
    outline: none;
    border: none;
}
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:selected:!active {
    background-color: @bg_surface@;
    color: @text_main@;
    border-radius: 8px;
    outline: none;
}
QTreeWidget::item:hover {
    background-color: @bg_surface@;
    border-radius: 8px;
}
/* Belt-and-suspenders: cover QListWidget if used elsewhere in the sidebar */
QListWidget {
    outline: none;
}
QListWidget:focus {
    outline: none;
}
QListWidget::item {
    border-radius: 8px;
    margin: 2px 8px;
    outline: none;
}
QListWidget::item:focus {
    outline: none;
    border: none;
}
QListWidget::item:selected,
QListWidget::item:selected:active,
QListWidget::item:selected:!active {
    background-color: @bg_surface@;
    color: @text_main@;
    border-radius: 8px;
}
QListView {
    outline: none;
}
QListView:focus {
    outline: none;
}
QListView::item {
    border-radius: 8px;
    margin: 2px 8px;
    outline: none;
}
QListView::item:focus {
    outline: none;
    border: none;
}
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:!active {
    background-color: @bg_surface@;
    color: @text_main@;
    border-radius: 8px;
}

/* =========================================================================
   QSplitter Handle — invisible grip, highlights on hover
   ========================================================================= */
QSplitter::handle {
    background-color: transparent;
}
QSplitter::handle:hover {
    background-color: @borders@;
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}



/* Unified input pill — the container IS the rounded bar */
QFrame#input_container {
    background-color: @bg_surface@;
    border: 1px solid @borders@;
    border-radius: 20px;
    padding: 4px 8px;
}

/* Buttons and text input inside the pill are invisible backgrounds */
QFrame#input_container QPushButton,
QFrame#input_container QToolButton {
    background: transparent;
    border: none;
    padding: 0px;
}
QFrame#input_container QPushButton:hover,
QFrame#input_container QToolButton:hover {
    background: transparent;
    border: none;
}
QFrame#input_container QTextEdit {
    background: transparent;
    border: none;
    padding: 8px 12px;
}


/* Legacy per-name overrides kept for backwards compat */
/* border-radius: 18px = half of fixed 36x36 size → guaranteed perfect circle */
QPushButton#attach_btn, QPushButton#mic_btn, QPushButton#send_btn {
    background-color: transparent;
    border: none;
    padding: 0px;
    border-radius: 18px;
}
QPushButton#attach_btn:hover, QPushButton#mic_btn:hover, QPushButton#send_btn:hover {
    background-color: transparent;
    border: none;
}


#swarm_hud {
    background: transparent;
    border: none;
}

#chat_scroll_area, #chat_scroll_widget {
    background: transparent;
    border: none;
}

QLabel#chat_watermark {
    color: @borders@;
    font-size: 32px;
    font-weight: bold;
    background: transparent;
}

/* =========================================================================
   Chat Bubbles
   ========================================================================= */
QFrame#chat_bubble {
    background-color: transparent;
    border: none;
}

QFrame#chat_bubble[role="user"] {
    background-color: transparent;
    border: none;
}
QFrame#chat_bubble[role="user"] QTextBrowser {
    color: #FFFFFF;
    background: transparent;
    border: none;
}

QFrame#chat_bubble[role="assistant"] {
    background-color: transparent;
    border: none;
}
QFrame#chat_bubble[role="assistant"] QTextBrowser {
    color: @text_main@;
    background: transparent;
    border: none;
}

/* =========================================================================
   System Dialogs — QGroupBox, QTableWidget, QProgressBar
   ========================================================================= */
QGroupBox {
    font-weight: bold;
    color: @text_main@;
    border: 1px solid @borders@;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
}

QTableWidget {
    background-color: @bg_base@;
    color: @text_main@;
    gridline-color: @borders@;
    border: 1px solid @borders@;
}

QTableWidget QHeaderView::section {
    background-color: @bg_surface@;
    color: @text_muted@;
}

QProgressBar {
    background-color: @bg_surface@;
    border: 1px solid @borders@;
    border-radius: @radius_sm@;
    text-align: center;
    color: @text_main@;
}

QProgressBar::chunk {
    background-color: @primary@;
}

/* =========================================================================
   Scheduler Dialog
   ========================================================================= */
QFrame#scheduler_task_row {
    background-color: @bg_surface@;
    border-radius: @radius_pill@;
    padding: 10px;
    margin-bottom: 10px;
}

QLabel#scheduler_task_label {
    color: @text_main@;
    font-size: 14px;
}

QLabel#scheduler_cron_label {
    color: @text_muted@;
    font-size: 12px;
}

QLabel#scheduler_empty {
    color: @text_muted@;
    font-style: italic;
}

QPushButton#scheduler_refresh {
    background-color: @primary@;
    color: @bg_base@;
    font-weight: bold;
    border-radius: @radius_pill@;
    padding: 6px 12px;
}

QPushButton#scheduler_toggle {
    font-weight: bold;
    border-radius: @radius_sm@;
    padding: 4px 8px;
}

QPushButton#scheduler_toggle[status="warning"] {
    background-color: @accent@;
    color: @bg_base@;
}

QPushButton#scheduler_toggle[status="success"] {
    background-color: @success@;
    color: @bg_base@;
}

QPushButton#scheduler_delete {
    background-color: @danger@;
    color: @bg_base@;
    font-weight: bold;
    border-radius: @radius_sm@;
    padding: 4px 8px;
}

/* =========================================================================
   Hardware Dialog
   ========================================================================= */
QLabel#hw_power_label {
    font-size: 14px;
    font-weight: bold;
}

QLabel#hw_power_label[status="success"] {
    color: @success@;
}

QLabel#hw_power_label[status="danger"] {
    color: @danger@;
}

QLabel#hw_model_label {
    color: @text_main@;
}

QTableWidgetItem#hw_status_released {
    color: @success@;
    font-weight: bold;
}

QTableWidgetItem#hw_status_sandboxed {
    color: @danger@;
    font-weight: bold;
}

/* =========================================================================
   Infrastructure Dialog
   ========================================================================= */
QProgressBar#infra_l1::chunk {
    background-color: @danger@;
}

QProgressBar#infra_l2::chunk {
    background-color: @accent@;
}

QProgressBar#infra_l3::chunk {
    background-color: @success@;
}

QTableWidgetItem#infra_status_running {
    color: @success@;
    font-weight: bold;
}

/* =========================================================================
   Governor Dialog
   ========================================================================= */
QTextEdit#governor_args {
    background-color: @bg_base@;
    border: 1px solid @borders@;
    padding: 5px;
    font-family: monospace;
}

QPushButton#governor_deny {
    background-color: @danger@;
    color: @bg_base@;
    font-weight: bold;
    padding: 8px;
}

QPushButton#governor_approve {
    background-color: @success@;
    color: @bg_base@;
    font-weight: bold;
    padding: 8px;
}

/* =========================================================================
   Security Dialog
   ========================================================================= */
QLabel#security_score {
    font-weight: bold;
    font-size: 24px;
}

QLabel#security_score[status="success"] {
    color: @success@;
}

QLabel#security_score[status="warning"] {
    color: @accent@;
}

QLabel#security_score[status="danger"] {
    color: @danger@;
}

QPushButton#security_heal {
    color: @danger@;
}

/* =========================================================================
   Settings Dialog
   ========================================================================= */
#settings_dialog {
    background-color: @bg_surface@;
    border: 1px solid @borders@;
}

#settings_title_label {
    font-size: 14px;
    font-weight: bold;
    color: @text_main@;
}

#settings_checkbox {
    font-size: 14px;
    font-weight: bold;
    color: @text_main@;
}

#danger_warning_label[status="danger"] {
    color: @danger@;
    font-size: 12px;
    font-weight: bold;
}

#danger_warning_label[status="muted"] {
    color: @text_muted@;
    font-size: 12px;
    font-weight: normal;
}

/* =========================================================================
   OOBE Wizard
   ========================================================================= */
#oobe_title {
    font-size: 32px;
    font-weight: 800;
    color: @text_main@;
}

#oobe_subtitle {
    font-size: 16px;
    color: @text_muted@;
}

#oobe_primary_btn {
    background-color: @accent@;
    color: @bg_base@;
    border: none;
    border-radius: @radius_pill@;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

#oobe_primary_btn:hover {
    background-color: @accent_hover@;
}

#oobe_preset_btn {
    background-color: @bg_deep@;
    color: @text_main@;
    border: 1px solid @borders@;
    border-radius: @radius_pill@;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

#oobe_preset_btn:hover {
    background-color: @bg_surface@;
}

#oobe_preset_btn:checked {
    background-color: @accent@;
    color: @bg_base@;
    border: 1px solid @accent@;
}

PersonaCard, ThemeCard {
    background-color: @bg_deep@;
    border-radius: @radius_lg@;
    border: 2px solid transparent;
}

PersonaCard:hover, ThemeCard:hover {
    background-color: @bg_surface@;
}

PersonaCard[selected="true"], ThemeCard[selected="true"] {
    border: 2px solid @accent@;
}

#oobe_combo, #oobe_text_edit {
    background-color: @bg_base@;
    color: @text_main@;
    border: 1px solid @borders@;
    border-radius: @radius_pill@;
    padding: 8px;
}

#oobe_check_box {
    font-size: 14px;
    font-weight: bold;
    color: @text_main@;
}

#oobe_directives_label {
    font-size: 12px;
    color: @text_muted@;
}

/* --- GLOBAL SCROLLBAR OVERRIDE --- */
QScrollBar:vertical { border: none; background: transparent; width: 6px; margin: 0px; }
QScrollBar::handle:vertical { background: rgba(255, 255, 255, 0.15); min-height: 20px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.3); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; border: none; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* --- GLOBAL BUTTON SQUIRCLE FALLBACK ---
   Ensures every QPushButton that doesn't match a more specific selector
   still gets rounded corners (8px minimum). The global rule at line ~44
   already uses @radius_pill@, so this is belt-and-suspenders for dialogs
   that might override padding but forget border-radius. */
QPushButton {
    border-radius: 8px;
}

/* =========================================================================
   Settings Button — explicit ID rule forces 8px squircle radius.
   Wins the cascade over AnimatedSquircleButton's custom paintEvent
   and the generic QPushButton rule above.
   ========================================================================= */
QPushButton#settings_btn {
    border-radius: 8px;
    background-color: @bg_surface@;
    color: @text_main@;
    border: 1px solid @borders@;
    padding: 6px 14px;
}
QPushButton#settings_btn:hover {
    border: 1px solid @primary@;
    color: @accent@;
    background-color: @bg_surface@;
}
QPushButton#settings_btn:pressed {
    background-color: @primary@;
    color: @bg_base@;
}
