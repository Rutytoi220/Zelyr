/* =====================================================================
   Zelyr Desktop v3.0 — Minimalist Light Theme
   ===================================================================== */

/* ---- Global Application ---- */
QWidget {
    background-color: #f9fafb;
    color: #111827;
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #f9fafb;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #f3f4f6;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f3f4f6;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #d1d5db;
    border-radius: 4px;
}

/* ---- Text Browser (Chat Area) ---- */
QTextBrowser#chatView {
    background-color: #ffffff;
    border: none;
    padding: 12px;
    selection-background-color: #10b981;
    selection-color: #ffffff;
}

/* ---- Chat Input ---- */
QTextEdit#chatInput {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
}
QTextEdit#chatInput:focus {
    border: 1px solid #10b981;
}

/* ---- Toolbar ---- */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    spacing: 6px;
    padding: 4px 10px;
}

/* ---- Tool Buttons ---- */
QToolButton {
    background-color: transparent;
    color: #4b5563;
    border: none;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
}
QToolButton:hover {
    background-color: #f3f4f6;
    color: #111827;
}
QToolButton:pressed {
    background-color: #e5e7eb;
}

/* ---- Send Button ---- */
QPushButton#sendBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#sendBtn:hover {
    background-color: #0ea572;
}
QPushButton#sendBtn:pressed {
    background-color: #059669;
}

/* ---- Auth Mode Buttons ---- */
QPushButton#authBasicBtn {
    background-color: #ffffff;
    color: #d97706;
    border: 1px solid #d97706;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authBasicBtn:checked {
    background-color: #d97706;
    color: #ffffff;
}

QPushButton#authAutopilotBtn {
    background-color: #ffffff;
    color: #059669;
    border: 1px solid #059669;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authAutopilotBtn:checked {
    background-color: #059669;
    color: #ffffff;
}

QPushButton#authStrictBtn {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #dc2626;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#authStrictBtn:checked {
    background-color: #dc2626;
    color: #ffffff;
}

/* ---- Expert Mode Toggle ---- */
QPushButton#expertToggleBtn {
    background-color: #ffffff;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#expertToggleBtn:checked {
    background-color: #f3f4f6;
    color: #059669;
    border-color: #10b981;
}

/* ---- Dock Widget (Expert Drawer) ---- */
QDockWidget {
    background-color: #f9fafb;
    color: #111827;
    border-left: 1px solid #e5e7eb;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}
QDockWidget::title {
    background-color: #f3f4f6;
    color: #4b5563;
    text-align: left;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid #e5e7eb;
}

/* ---- Expert Panel Text ---- */
/* Keep this somewhat dark/terminal-like even in light mode for readability of logs */
QTextEdit#expertLog {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #0f172a;
    border-radius: 6px;
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
    padding: 8px;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #f3f4f6;
    color: #4b5563;
    border-top: 1px solid #e5e7eb;
    font-size: 11px;
    padding: 2px 8px;
}

/* ---- Labels ---- */
QLabel#modelLabel {
    color: #059669;
    font-size: 11px;
    font-weight: 600;
}
QLabel#modeLabel {
    font-size: 11px;
    font-weight: 600;
}

/* ---- System Tray ---- */
QMenu {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #f3f4f6;
}
QMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 8px;
}

/* ---- Dialogs & Forms ---- */
QDialog {
    background-color: #ffffff;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 4px 8px;
    color: #111827;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    selection-background-color: #f3f4f6;
    selection-color: #111827;
}

QCheckBox {
    color: #111827;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #d1d5db;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #10b981;
    border: 1px solid #10b981;
}

QLabel {
    color: #111827;
}

/* ---- Chat Bubbles ---- */
QFrame#msgBubble[bubbleRole="user"] {
    background: #ecfdf5; border: 1px solid #10b981;
    border-radius: 12px; padding: 10px 14px;
}
QFrame#msgBubble[bubbleRole="assistant"] {
    background: #f3f4f6; border: 1px solid #e5e7eb;
    border-radius: 12px; padding: 10px 14px;
}
QFrame#msgBubble[bubbleRole="tool"] {
    background: #fef2f2; border: 1px solid #ef4444;
    border-radius: 12px; padding: 10px 14px;
}
QLabel#roleLabel_user { font-weight:600; font-size:12px; color: #d97706; }
QLabel#roleLabel_assistant { font-weight:600; font-size:12px; color: #059669; }
QLabel#roleLabel_tool { font-weight:600; font-size:12px; color: #dc2626; }
QLabel#msgTimestamp { font-size:10px; color:#9ca3af; }
QLabel#msgBody { color:#111827; font-size:13px; line-height:1.5; }

/* ---- Tool Pills ---- */
QFrame#toolPill {
    background: #ffffff; border: 1px solid #e5e7eb;
    border-radius: 6px; padding: 2px 8px;
}
QLabel#toolPillSummary { color: #4b5563; font-size: 11px; }
QToolButton#toolPillToggle { color: #4b5563; border: none; font-size: 10px; }
QLabel#toolPillDetail { color: #6b7280; font-size: 11px; font-family: monospace; }

QWidget#bottomBar {
    background: #f3f4f6;
    border-top: 1px solid #e5e7eb;
}
